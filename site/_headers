# La marque et les icônes du manifeste sont régénérées par generer-logo.py et
# gardent leur nom d'une version à l'autre : elles ne peuvent pas être immuables,
# sans quoi un visiteur conserverait l'ancien dessin. Règles avant le joker :
# Netlify retient la plus spécifique.
/assets/img/logo-eden.svg
  Cache-Control: public, max-age=604800
/assets/img/icon-192.png
  Cache-Control: public, max-age=604800
/assets/img/icon-512.png
  Cache-Control: public, max-age=604800
/assets/img/icon-maskable-512.png
  Cache-Control: public, max-age=604800

# Les variantes de photos, elles, portent leur largeur dans leur nom : un
# contenu différent est un fichier différent. Cache d'un an, immuable.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Les polices auto-hébergées portent leur graisse et leur sous-ensemble dans
# leur nom : un contenu différent serait un fichier différent. Cache d'un an.
# Leurs @font-face vivent dans styles.css et non dans une feuille séparée :
# une requête bloquante de moins dans le chemin critique.
/assets/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# CSS et JS gardent leur nom d'une version à l'autre : pas d'immutable, mais
# une revalidation peu coûteuse plutôt qu'un re-téléchargement complet.
/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=86400, must-revalidate

# Icônes et manifeste : stables, mais susceptibles d'être régénérés.
/favicon.*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# Les pages doivent refléter les mises à jour de contenu immédiatement.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
